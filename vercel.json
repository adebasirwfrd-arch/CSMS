{
    "rewrites": [
        { "source": "/(.*)", "destination": "/api/index.py" }
    ],
    "functions": {
        "api/index.py": {
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/matrix/send-expiry-reminders",
            "schedule": "0 7 * * *"
        }
    ]
}
